{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",

    // Standard strict settings
    "strict": true,

    // Required for ts-lombok-kit:
    // TypeScript's type checker runs BEFORE the transformer adds constructors,
    // so it can't see the generated constructor parameters or methods.
    // This is a fundamental limitation of TypeScript decorators.
    "strictPropertyInitialization": false,
    "noEmitOnError": false,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "plugins": [
      {
        "transform": "ts-lombok-kit"
      }
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
